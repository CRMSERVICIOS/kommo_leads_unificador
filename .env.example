# Subdominio de la cuenta Kommo, ej: si tu URL es https://miempresa.kommo.com el valor es "miempresa"
KOMMO_SUBDOMAIN=

# Token de integracion privada (long-lived token) generado desde Kommo (Ajustes > Integraciones > Tu integracion).
# Ver: https://developers.kommo.com/docs/long-lived-token
KOMMO_LONG_LIVED_TOKEN=

# Secreto para validar la firma/origen de los webhooks de Kommo, si la cuenta lo provee.
# TODO: confirmar con credenciales reales si Kommo firma los webhooks salientes y de que forma
# (los webhooks "clasicos" de Kommo historicamente NO llevan firma, solo se puede validar por IP/subdominio).
KOMMO_WEBHOOK_SECRET=

# URL de un Incoming Webhook de Slack para notificaciones. Si se deja vacio, solo se loguea.
SLACK_WEBHOOK_URL=

# Path del archivo SQLite (se crea automaticamente si no existe).
DATABASE_URL=./data/dedup.sqlite

# Puerto HTTP del servidor.
PORT=3000

# Codigo de pais por defecto para normalizar telefonos que llegan sin codigo de pais (Argentina = 54).
DEFAULT_COUNTRY_CODE=54

# Modo simulacion: cuando es "true" (o si se deja sin definir, ese es el default),
# el servicio detecta duplicados, indexa telefonos y registra todo en la DB igual
# que siempre, pero NO ejecuta las escrituras reales a Kommo (addNote/addTag) --
# en su lugar solo loguea que las haria. Poner DRY_RUN=false para habilitarlas.
DRY_RUN=true
