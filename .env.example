# Subdominio de la cuenta Kommo, ej: si tu URL es https://miempresa.kommo.com el valor es "miempresa"
KOMMO_SUBDOMAIN=

# Token de integracion privada (long-lived token) generado desde Kommo (Ajustes > Integraciones > Tu integracion).
# Ver: https://developers.kommo.com/docs/long-lived-token
KOMMO_LONG_LIVED_TOKEN=

# Secreto para validar la firma/origen de los webhooks de Kommo, si la cuenta lo provee.
# TODO: confirmar con credenciales reales si Kommo firma los webhooks salientes y de que forma
# (los webhooks "clasicos" de Kommo historicamente NO llevan firma, solo se puede validar por IP/subdominio).
KOMMO_WEBHOOK_SECRET=

# URL de un Incoming Webhook de Slack para notificaciones. Si se deja vacio, solo se loguea.
SLACK_WEBHOOK_URL=

# Connection string de Postgres. Local: `npm run test:db:up` levanta uno en el puerto 5433.
# DO Managed Database: postgresql://user:pass@host:25060/db?sslmode=require
DATABASE_URL=postgresql://dedup:dedup@localhost:5433/dedup
# CA del Postgres administrado (DO App Platform: ${<db>.CA_CERT}). Opcional.
DATABASE_CA_CERT=

# Puerto HTTP del servidor.
PORT=3000

# Codigo de pais por defecto para normalizar telefonos que llegan sin codigo de pais (Argentina = 54).
DEFAULT_COUNTRY_CODE=54

# Freno de emergencia. Por defecto (sin definir o "false") los duplicados se resuelven
# automaticamente en Kommo: gana el lead/contacto de id mas alto (no se toca) y el lead
# perdedor se vincula al contacto ganador y se mueve al embudo Duplicados.
# Con DRY_RUN=true el detector solo loguea lo que haria, sin escribir nada en Kommo.
DRY_RUN=true

# Token para las rutas de administracion (POST /admin/unify-test). Mandarlo como
# header "Authorization: Bearer <ADMIN_TOKEN>". Si se deja vacio, /admin queda deshabilitado.
# OJO: /admin/unify-test escribe en Kommo aunque DRY_RUN=true (salvo "dryRun": true en el body).
ADMIN_TOKEN=
